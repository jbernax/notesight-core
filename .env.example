# =============================================================================
# NoteSight Core - Local Environment Configuration Template
# Copy this file to .env before starting services:
#   cp .env.example .env
# =============================================================================

# Deployment Environment ('development', 'production')
ENVIRONMENT=development

# Security: JWT Signing Secret (Generate with: openssl rand -hex 32)
SECRET_KEY=dev-insecure-secret-key-for-local-development-only

# Local Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://omr_user:omr_password@db:5432/omr_db
AUTO_MIGRATE=true

# Local Redis & Celery Task Queue
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ALWAYS_EAGER=false

# Storage Layer (Local filesystem storage)
STORAGE_BACKEND=local

# Security & CORS Origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:8080

# Rate Limiting & Bounds
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
MAX_PDF_PAGES=200
OMR_TIMEOUT_SECONDS=120
